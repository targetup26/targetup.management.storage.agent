{
    "name": "target-storage-agent",
    "version": "1.0.0",
    "description": "Distributed file storage agent for Target-Attendance",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "install-service": "node install-service.js",
        "uninstall-service": "node uninstall-service.js"
    },
    "keywords": [
        "storage",
        "electron",
        "windows-service"
    ],
    "author": "Target Team",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.2",
        "axios-retry": "^4.0.0",
        "body-parser": "^1.20.2",
        "check-disk-space": "^3.4.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "node-windows": "^1.0.0-beta.8",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "pkg": "^5.8.1"
    },
    "bin": {
        "target-storage-agent": "server.js",
        "target-storage-installer": "installer.js"
    },
    "pkg": {
        "assets": [
            "assets/**/*",
            ".env"
        ],
        "targets": [
            "node18-win-x64"
        ],
        "outputPath": "dist"
    }
}